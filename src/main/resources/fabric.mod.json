{
  "schemaVersion": 1,
  "id": "esp",
  "version": "${version}",
  "name": "Through-Wall ESP",
  "description": "Client-side ESP overlays for chests, entities and other players.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.kodari.esp.EspClient"
    ],
    "modmenu": [
      "com.kodari.esp.EspModMenu"
    ]
  },
  "mixins": [
    {
      "config": "esp.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.9.0"
  },
  "suggests": {
    "modmenu": ">=21.0.0"
  }
}